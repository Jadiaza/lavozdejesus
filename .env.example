VITE_ADSENSE_CLIENT=ca-pub-4848923962603353
VITE_ADSENSE_PROGRAMACION_SLOT=
VITE_ADSENSE_RADIO_SLOT=

# Backend PHP publicado en el hosting cPanel.
# En Vercel, estas variables se leen durante el build y requieren redeploy.
VITE_API_BASE_URL=https://lavozdejesus.co
VITE_APP_CONFIG_API_URL=https://lavozdejesus.co/api/config.php
VITE_LITURGIA_API_URL=https://lavozdejesus.co/api/liturgia.php
VITE_LECTIO_API_URL=https://lavozdejesus.co/api/lectio.php
VITE_SANTORAL_API_URL=https://lavozdejesus.co/api/santoral.php
VITE_PROGRAMACION_API_URL=https://lavozdejesus.co/api/programacion.php
VITE_CAPILLA_API_URL=https://lavozdejesus.co/api/capilla.php
VITE_BIBLE_STUDY_API_URL=https://lavozdejesus.co/api/biblia-estudios.php

# Acceso gratuito de usuarios. Se configuran en Supabase > Project Settings > API.
# En Authentication > URL Configuration > Redirect URLs autorizar:
# http://localhost:8080/acceso**
# http://localhost:8080/acceso/recuperar**
# https://TU-DOMINIO-PWA/acceso**
# https://TU-DOMINIO-PWA/acceso/recuperar**
VITE_SUPABASE_URL=https://zcfnquusvkrkqjeusmly.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo para endpoints Node/Vercel. No usar con prefijo VITE_.
# Si la app consume el backend PHP anterior, estas variables no son necesarias.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=lavozdej_Radio
MYSQL_USER=
MYSQL_PASSWORD=

# Lectura del Día - Ordo Colombiano.
# Configuración exclusivamente de servidor. Nunca usar prefijo VITE_.
# Si ORDO_COLOMBIANO_API_URL queda vacío, el proveedor usa el endpoint público
# conocido de contenido principal del Ordo Colombiano.
ORDO_COLOMBIANO_API_URL=https://74j2tngwfd.execute-api.us-east-1.amazonaws.com/api-app/ediciones/obtener-contenido-principal
# Encabezados opcionales usados por el cliente oficial cuando sean requeridos.
ORDO_COLOMBIANO_API_NAME=
ORDO_COLOMBIANO_API_KEY=
ORDO_COLOMBIANO_API_TOKEN=
ORDO_COLOMBIANO_TIMEOUT=20
# Clave aleatoria larga para proteger POST /api/liturgia-sync-ordo.php desde cron.
ORDO_COLOMBIANO_SYNC_KEY=

# Generación automática de Lectio Divina.
# La IA solo crea BORRADORES; nunca publica automáticamente.
# El administrador revisa el borrador y cambia estado a "publicado" de forma manual.
# Si LECTIO_AI_API_KEY queda vacío, se reutiliza BIBLE_AI_API_KEY del backend.
LECTIO_AI_API_KEY=
LECTIO_AI_MODEL=
LECTIO_AI_TIMEOUT=180
LECTIO_AI_MAX_TOKENS=6000

# Generación automática del Santo del Día a partir de celebracion_santo del Ordo.
# Ordo decide la identidad; la IA solo prepara el borrador editorial LVJ.
# Nunca se publica automáticamente y la imagen sigue siendo de revisión manual.
# Si SANTORAL_AI_API_KEY queda vacío, se reutiliza BIBLE_AI_API_KEY del backend.
SANTORAL_AI_API_KEY=
SANTORAL_AI_MODEL=
SANTORAL_AI_TIMEOUT=180
SANTORAL_AI_MAX_TOKENS=6000
