# Acceso gratuito de usuarios. Se configuran en Supabase > Project Settings > API.
# En Authentication > URL Configuration > Redirect URLs autorizar:
# http://localhost:8080/acceso**
# http://localhost:8080/acceso/recuperar**
# https://TU-DOMINIO-PWA/acceso**
# https://TU-DOMINIO-PWA/acceso/recuperar**
VITE_SUPABASE_URL=https://zcfnquusvkrkqjeusmly.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo para endpoints Node/Vercel. No usar con prefijo VITE_.
# Si la app consume el backend PHP anterior, estas variables no son necesarias.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=lavozdej_Radio
MYSQL_USER=
MYSQL_PASSWORD=

# Lectura del Día - Ordo Colombiano.
# Configuración exclusivamente de servidor. Nunca usar prefijo VITE_.
# La URL debe apuntar a un endpoint JSON autorizado y puede usar {fecha} o {date}.
# Ejemplo: https://proveedor-autorizado.example/api/liturgia/{fecha}
ORDO_COLOMBIANO_API_URL=
ORDO_COLOMBIANO_API_TOKEN=
ORDO_COLOMBIANO_TIMEOUT=12
# Clave aleatoria larga para proteger POST /api/liturgia-sync-ordo.php desde cron.
ORDO_COLOMBIANO_SYNC_KEY=
